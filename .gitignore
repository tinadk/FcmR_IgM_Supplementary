# IDE
.idea/
.vscode/
.DS_Store

# Output directory
output/

# Data files
*.xvg
*.npy
*.dat
*.pdb
*.gro
*.xtc
*.trr

# Python
__pycache__/
*.pyc
*.pyo

# Jupyter
.ipynb_checkpoints/
*.ipynb

# ----------------------------------------------------------------
# Ignore generated images by default
# ----------------------------------------------------------------
*.jpg
*.png
*.pdf
*.svg

# ----------------------------------------------------------------
# But track these specific directories (override above rules)
# ----------------------------------------------------------------
# Main Figures (track everything inside)
!Main_Figures/**/*.jpg
!Main_Figures/**/*.png
!Main_Figures/**/*.pdf
!Main_Figures/**/*.svg

# Supplementary Figures (track everything inside)
!Supplementary_Materials_for_review/Supplementary_Figures/**/*.jpg
!Supplementary_Materials_for_review/Supplementary_Figures/**/*.png
!Supplementary_Materials_for_review/Supplementary_Figures/**/*.pdf
!Supplementary_Materials_for_review/Supplementary_Figures/**/*.svg

# Supplementary Tables (track everything inside)
!Supplementary_Materials_for_review/Supplementary_Tables/**/*.xlsx

# Supplementary Information PDF
!Supplementary_Materials_for_review/Supplementary_Information.pdf

# Source Data (track everything inside)
!Source_Data/**/*

# FoldX Config (track everything inside)
!FoldX_Config/**/*