# IDE
.idea/
.vscode/
.DS_Store

# Output directory
output/

# Data files
*.xvg
*.npy
*.dat
*.pdb
*.gro
*.xtc
*.trr

# Python
__pycache__/
*.pyc
*.pyo

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Ignore generated figures outside tracked folders
*.jpg
*.png
*.pdf
*.svg

# Keep main figures tracked
!main_figures/
!main_figures/*.jpg
!main_figures/*.svg
!main_figures/*.png
!main_figures/*.pdf

# Keep supplementary materials tracked
!supplementary_materials/
!supplementary_materials/supplementary_figures/
!supplementary_materials/supplementary_figures/*.jpg
!supplementary_materials/supplementary_figures/*.svg
!supplementary_materials/supplementary_figures/*.png
!supplementary_materials/supplementary_figures/*.pdf
!supplementary_materials/supplementary_tables/
!supplementary_materials/supplementary_tables/*.xlsx
!supplementary_materials/supplementary_information.pdf

# Keep source data and FoldX configuration
!source_data/
!foldx_config/